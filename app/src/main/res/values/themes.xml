<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.QueueLessPlus" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorTextPrimary</item>
        <item name="colorSecondaryVariant">@color/colorPrimaryLight</item>

        <!-- Background & surface -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>

        <!-- Text colors -->
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextHint</item>

        <!-- Surface text and icons -->
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="hintTextColor">@color/colorTextHint</item>

        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/colorBackground</item>

        <!-- Shape and input -->
        <item name="materialCardViewStyle">@style/QueueLess.Card</item>
        <item name="textInputStyle">@style/QueueLess.TextInputLayout</item>
        <item name="materialButtonStyle">@style/QueueLess.Button</item>
        <item name="materialButtonOutlinedStyle">@style/QueueLess.Button.Outlined</item>

    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.QueueLessPlus.Splash" parent="Theme.QueueLessPlus">
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
    </style>

    <!-- ActionBar theme -->
    <style name="Theme.QueueLessPlus.AppBarOverlay"
        parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- Popup theme -->
    <style name="Theme.QueueLessPlus.PopupOverlay"
        parent="ThemeOverlay.MaterialComponents.Light" />

    <!-- Text input style -->
    <style name="QueueLess.TextInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/colorDivider</item>
        <item name="boxBackgroundColor">@color/colorSurfaceVariant</item>
        <item name="hintTextColor">@color/colorTextHint</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textColorHint">@color/colorTextHint</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Card style -->
    <style name="QueueLess.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="strokeColor">@color/colorDivider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Buttons -->
    <style name="QueueLess.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/colorPrimary</item>
    </style>

    <!-- Outlined Button -->
    <style name="QueueLess.Button.Outlined"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="strokeColor">@color/colorDivider</item>
    </style>

</resources>
